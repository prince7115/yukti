# Server Port (Default: 3000)
PORT=3000

# Express Session Secret Key
SESSION_SECRET=yukti_super_secret_session_key_2026

# OpenAI API Key (preferred AI provider) - powers Kaam Kahani skill discovery,
# career explanations, Parent Pitch messages and the AI Tutor.
# Get a key at https://platform.openai.com/api-keys (a ChatGPT subscription does not include API access).
OPENAI_API_KEY=
# Optional: OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=

# Google Gemini API Key (used only if OPENAI_API_KEY is empty)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, Yukti automatically runs in built-in offline-compatible pedagogical mode.
GEMINI_API_KEY=
