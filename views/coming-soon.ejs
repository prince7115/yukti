<%
  const hi = (lang === 'hi');
  const L = (en, hiText) => hi ? hiText : en;
%>
<%- include('partials/header', { pageTitle: hi ? feature.title_hi : feature.title }) %>
<%- include('partials/navbar', { activeTab: activeTab }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: activeTab }) %>

  <main class="app-content">
    <div class="lms-header-box">
      <div class="lms-header-info">
        <h1 class="lms-title"><%= feature.icon %> <%= hi ? feature.title_hi : feature.title %></h1>
        <p class="lms-subtitle"><%= hi ? feature.summary_hi : feature.summary %></p>
      </div>
      <span class="badge badge-warning">🚧 <%= L('Coming soon', 'जल्द आ रहा है') %></span>
    </div>

    <section class="card" style="padding: 1.5rem; margin-bottom: 1.5rem; max-width: 760px;">
      <h2 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.75rem;"><%= L('What this will do', 'यह क्या करेगा') %></h2>
      <ul style="display: grid; gap: 0.6rem; padding-left: 0; list-style: none; margin: 0;">
        <% feature.features.forEach(f => { %>
          <li style="display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.92rem;">
            <span style="color: var(--success);">✔</span><span><%= hi ? f[1] : f[0] %></span>
          </li>
        <% }); %>
      </ul>
    </section>

    <section class="card" style="padding: 1.25rem; max-width: 760px;">
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.75rem;"><%= L('Available now:', 'अभी उपलब्ध:') %></p>
      <a href="/hunar" class="btn btn-primary">🎤 <%= L('Try Kaam Kahani – find your skills', 'काम कहानी आज़माएं – अपने हुनर खोजें') %></a>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
        <% Object.entries(allFeatures).forEach(([key, f]) => { if (f === feature) return; %>
          <a href="/hunar/<%= key %>" class="badge badge-slate" style="text-decoration: none;"><%= f.icon %> <%= hi ? f.title_hi : f.title %></a>
        <% }); %>
      </div>
    </section>
  </main>
</div>

<%- include('partials/bottom-nav', { activeTab: activeTab }) %>
<%- include('partials/footer') %>
